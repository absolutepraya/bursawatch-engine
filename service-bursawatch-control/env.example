# This is a tracked field-name template, never a place for secrets.
# Keep real local values in the ignored service-bursawatch-control/.env in the
# main worktree. The reviewed VPS service deployment will read its scoped
# values from ~/.hermes/bursawatch-control-plane.env instead.

CONTROL_PLANE_STORE=postgres
DATABASE_URL=
CONTROL_PLANE_ALLOWED_ORIGINS=

# Profile avatar metadata resolver. The default reaches the VPS-local RSSHub.
CONTROL_PLANE_RSSHUB_BASE_URL=http://127.0.0.1:1200
CONTROL_PLANE_AVATAR_FETCH_TIMEOUT_SECONDS=10
CONTROL_PLANE_AVATAR_REFRESH_STALE_SECONDS=86400

# Supabase Auth verifies browser access tokens through the project's public
# JWKS endpoint. This is a URL, not an API key.
CONTROL_PLANE_SUPABASE_URL=
CONTROL_PLANE_ADMIN_USER_IDS=

# Dedicated bearer credential for cron config reads and event writes.
CONTROL_PLANE_MACHINE_TOKEN=

# Separate credential for the VPS scheduler reconciler. It may read desired
# interval schedules and report verified results, but cannot read cron config
# or use any human dashboard route.
CONTROL_PLANE_RECONCILER_TOKEN=

# Trusted deployed watcher parser locations. Do not point these at web input.
CONTROL_PLANE_X_CONFIG_VALIDATOR_DIR=
CONTROL_PLANE_IG_CONFIG_VALIDATOR_DIR=
CONTROL_PLANE_WA_CONFIG_VALIDATOR_DIR=
CONTROL_PLANE_MARKET_NEWS_CONFIG_VALIDATOR_DIR=
CONTROL_PLANE_SWING_BOARD_CONFIG_VALIDATOR_DIR=
CONTROL_PLANE_PHINTRACO_CONFIG_VALIDATOR_DIR=
CONTROL_PLANE_KELAS_INVESTASI_GTW_CONFIG_VALIDATOR_DIR=
CONTROL_PLANE_STOCKBIT_CONFIG_VALIDATOR_DIR=/home/praya/.hermes/bursawatch-control-plane/validator-sources/bursawatch-stockbit-snips
