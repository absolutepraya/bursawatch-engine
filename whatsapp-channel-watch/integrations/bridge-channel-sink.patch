@@ -250,0 +250,48 @@
+async function enqueueChannelMessage(msg) {
+  if (!channelSink) return false;
+  const preliminary = channelSink.normalizeChannelMessage({ msg });
+  if (!preliminary) return false;
+
+  let mediaPath = null;
+  if (preliminary.media.length > 0) {
+    const chatId = msg.key.remoteJid;
+    const senderId = msg.key.participant || chatId;
+    const senderNumber = senderId.replace(/@.*/, '');
+    try {
+      const event = await extractBridgeEvent({
+        msg,
+        chatId,
+        senderId,
+        senderNumber,
+        botIds: [],
+        isGroup: false,
+        downloadMedia: async (mediaMsg) => downloadMediaMessage(
+          mediaMsg,
+          'buffer',
+          {},
+          { logger, reuploadRequest: sock.updateMediaMessage },
+        ),
+        cacheDirs: {
+          image: IMAGE_CACHE_DIR,
+          document: DOCUMENT_CACHE_DIR,
+          audio: AUDIO_CACHE_DIR,
+        },
+      });
+      mediaPath = event.mediaUrls?.find((value) => typeof value === 'string' && value) || null;
+    } catch (err) {
+      console.warn('[bridge] failed to prepare WhatsApp Channel media:', err?.message || err);
+    }
+  }
+
+  const payload = channelSink.normalizeChannelMessage({ msg, mediaPath });
+  if (!payload) return false;
+  const inserted = channelSink.enqueueChannelEvent(payload, CHANNEL_QUEUE_DIR);
+  emitDebugEvent({
+    stage: inserted ? 'channel_queued' : 'channel_duplicate',
+    channelJid: redactWhatsAppId(payload.channel_jid),
+    messageId: payload.message_id,
+    hasText: Boolean(payload.text),
+    mediaCount: payload.media.length,
+  });
+  return inserted;
+}
