+// Optional additive sink for WhatsApp Channel posts. The sink lives in the
+// watcher runtime so the bridge can keep its existing ownership boundary and
+// remain usable when the watcher is absent.
+const CHANNEL_SINK_PATH = process.env.WHATSAPP_CHANNEL_SINK_PATH
+  || path.join(process.env.HOME || '~', '.agents', 'skills', 'whatsapp-channel-watch', 'bin', 'channel_sink.mjs');
+const CHANNEL_QUEUE_DIR = process.env.WHATSAPP_CHANNEL_QUEUE_DIR
+  || path.join(process.env.HOME || '~', '.hermes', 'state', 'whatsapp-channel-watch', 'queue');
+let channelSink = null;
+try {
+  if (existsSync(CHANNEL_SINK_PATH)) {
+    channelSink = await import(pathToFileURL(CHANNEL_SINK_PATH).href);
+  }
+} catch (err) {
+  console.warn('[bridge] WhatsApp Channel sink unavailable:', err?.message || err);
+}
