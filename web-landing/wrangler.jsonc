{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bursawatch-landing",
  "account_id": "40ffe81c2b657eebc19edd8558b5f5ba",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "bursawatch.abhipraya.dev",
      "custom_domain": true
    }
  ],
  "vars": {
    "BURSAWATCH_CONFIG_URL": "https://dash.bursawatch.abhipraya.dev"
  }
}
