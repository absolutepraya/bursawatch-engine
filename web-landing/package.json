{
  "name": "bursawatch-web-landing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev --port 3200",
    "build": "NEXT_DIST_DIR=.next-build next build",
    "start": "NEXT_DIST_DIR=.next-build next start --port 3200",
    "lint": "eslint .",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css}'",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}'",
    "typecheck": "NEXT_DIST_DIR=.next-build next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node scripts/browser-smoke.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "build:workers": "NEXT_DIST_DIR=.next opennextjs-cloudflare build",
    "preview:workers": "opennextjs-cloudflare preview",
    "deploy:workers": "opennextjs-cloudflare deploy",
    "typegen:workers": "wrangler types --env-interface CloudflareEnv --include-runtime=false cloudflare-env.d.ts",
    "check:workers": "npm run build:workers && wrangler deploy --dry-run",
    "build:next:workers": "NEXT_DIST_DIR=.next next build"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "lucide-react": "1.45.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.2",
    "playwright": "^1.58.2",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "vitest": "5.0.0",
    "@opennextjs/cloudflare": "1.20.13",
    "wrangler": "4.152.0"
  }
}
