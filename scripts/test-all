#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
if [[ -n "${PYTHON:-}" ]]; then
  python_bin="$PYTHON"
elif [[ -x "$repo_root/.venv/bin/python" ]]; then
  python_bin="$repo_root/.venv/bin/python"
elif [[ -x "$repo_root/../../.venv/bin/python" ]]; then
  python_bin="$repo_root/../../.venv/bin/python"
else
  python_bin="$repo_root/.venv/bin/python"
fi

# Resolve a caller-supplied relative interpreter before each suite changes
# directory. CI supplies `python`; local worktrees may supply `../../.venv/bin/python`.
if [[ "$python_bin" == */* && "$python_bin" != /* ]]; then
  python_bin="$(cd "$(dirname "$python_bin")" && pwd)/$(basename "$python_bin")"
fi

if ! command -v "$python_bin" >/dev/null 2>&1 && [ ! -x "$python_bin" ]; then
  echo "test runner not found: $python_bin" >&2
  exit 1
fi

run_suite() {
  local name="$1" directory="$2" target="$3"
  printf '\n== %s ==\n' "$name"
  (cd "$repo_root/$directory" && "$python_bin" -m pytest -q "$target")
}

run_suite service-bursawatch-discord-delivery service-bursawatch-discord-delivery tests
run_suite lib-bursawatch-discord-delivery lib-bursawatch-discord-delivery tests
run_suite cron-tg-market-news cron-tg-market-news tests
run_suite cron-tg-source-ingest cron-tg-source-ingest tests
run_suite lib-bursawatch-source-ingest lib-bursawatch-source-ingest tests
run_suite lib-bursawatch-source-media lib-bursawatch-source-media tests
run_suite cron-x-source-ingest cron-x-source-ingest tests
run_suite cron-ig-source-ingest cron-ig-source-ingest tests
run_suite cron-wa-source-ingest cron-wa-source-ingest tests
run_suite cron-rss-source-ingest cron-rss-source-ingest tests
run_suite cron-tg-phintraco-swing cron-tg-phintraco-swing tests
run_suite lib-news-format lib-news-format tests
run_suite lib-swing-format lib-swing-format tests
run_suite cron-dc-swing-board cron-dc-swing-board tests
run_suite cron-ig-account-watch cron-ig-account-watch tests
run_suite cron-tg-kelas-investasi-gtw cron-tg-kelas-investasi-gtw tests
run_suite lib-telegram-resilience lib-telegram-resilience tests
run_suite lib-bursawatch-control lib-bursawatch-control tests
run_suite lib-bursawatch-pipeline-runtime lib-bursawatch-pipeline-runtime tests
run_suite cron-x-account-watch cron-x-account-watch tests
run_suite cron-stockbit-snips cron-stockbit-snips tests
if [[ "${SKIP_WHATSAPP_CHANNEL_WATCH:-0}" == "1" ]]; then
  printf '\n== cron-wa-channel-watch == dedicated CI job\n'
else
  run_suite cron-wa-channel-watch cron-wa-channel-watch tests
fi
run_suite service-bursawatch-control service-bursawatch-control tests
run_suite service-bursawatch-source-media service-bursawatch-source-media tests
run_suite platform-bursawatch-observer platform-bursawatch-observer tests
run_suite platform-hermes-schedule-reconciler platform-hermes-schedule-reconciler tests
run_suite platform-bursawatch-release platform-bursawatch-release tests
if [[ "${SKIP_WHATSAPP_CHANNEL_WATCH:-0}" != "1" ]]; then
  printf '\n== cron-wa-channel-watch JavaScript sink ==\n'
  node --test "$repo_root/cron-wa-channel-watch/tests/channel_sink.test.mjs"
fi
run_suite profile-emoji .agents/skills/profile-emoji tests

run_suite lib-sectors lib-sectors tests
run_suite lib-chart-img lib-chart-img tests
run_suite lib-yahoo-market-data lib-yahoo-market-data tests
run_suite cron-dc-morning-brief cron-dc-morning-brief tests

run_suite repository-policy . tests
