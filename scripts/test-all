#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
python_bin="${PYTHON:-$repo_root/.venv/bin/python}"

if ! command -v "$python_bin" >/dev/null 2>&1 && [ ! -x "$python_bin" ]; then
  echo "test runner not found: $python_bin" >&2
  exit 1
fi

run_suite() {
  local name="$1" directory="$2" target="$3"
  printf '\n== %s ==\n' "$name"
  (cd "$repo_root/$directory" && "$python_bin" -m pytest -q "$target")
}

run_suite cron-tg-market-news cron-tg-market-news tests
run_suite cron-tg-phintraco-swing cron-tg-phintraco-swing tests
run_suite lib-swing-format lib-swing-format tests
run_suite cron-dc-swing-board cron-dc-swing-board tests
run_suite cron-ig-account-watch cron-ig-account-watch tests
run_suite cron-tg-kelas-investasi-gtw cron-tg-kelas-investasi-gtw tests
run_suite skill-guess-stock skill-guess-stock tests
run_suite lib-telegram-resilience lib-telegram-resilience tests
run_suite lib-bursawatch-control lib-bursawatch-control tests
run_suite cron-x-account-watch cron-x-account-watch tests
run_suite cron-wa-channel-watch cron-wa-channel-watch tests
run_suite service-bursawatch-control service-bursawatch-control tests
run_suite platform-hermes-schedule-reconciler platform-hermes-schedule-reconciler tests
run_suite platform-bursawatch-release platform-bursawatch-release tests
printf '\n== cron-wa-channel-watch JavaScript sink ==\n'
node --test "$repo_root/cron-wa-channel-watch/tests/channel_sink.test.mjs"
run_suite skill-profile-emoji skill-profile-emoji tests

run_suite repository-policy . tests
