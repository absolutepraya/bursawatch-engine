# Mode 0600 on the VPS. This file is never committed with a real value.
BURSAWATCH_RELEASE_GITHUB_TOKEN=<fine-grained-read-only-github-token>
# Optional separate fine-grained token with Commit statuses: write only.
# BURSAWATCH_RELEASE_STATUS_TOKEN=<fine-grained-commit-status-write-token>
# Optional target URL for the visible bursawatch/release status.
# BURSAWATCH_RELEASE_STATUS_TARGET_URL=https://hermes.abhipraya.dev
BURSAWATCH_RELEASE_REPOSITORY=absolutepraya/bursawatch
BURSAWATCH_RELEASE_BRANCH=main
BURSAWATCH_RELEASE_STATE_ROOT=/home/praya/.local/share/bursawatch-release
BURSAWATCH_RELEASE_RUNTIME_HOME=/home/praya/.agents/skills
BURSAWATCH_RELEASE_CONTROL_PLANE_RUNTIME=/home/praya/.hermes/bursawatch-control-plane
BURSAWATCH_RELEASE_CONTROL_PLANE_ENV=/home/praya/.hermes/bursawatch-control-plane.env
BURSAWATCH_RELEASE_HEARTBEAT_ENV=/home/praya/.hermes/.env
BURSAWATCH_RELEASE_HEARTBEAT_CHANNEL_ID=1505162000420835388
BURSAWATCH_RELEASE_TIMEOUT_SECONDS=30
