[Unit]
Description=Release eligible Bursawatch main commits
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=praya
Group=praya
EnvironmentFile=/home/praya/.hermes/bursawatch-release-agent.env
ExecStart=/home/praya/.local/lib/bursawatch-release/bursawatch-release-agent.sh --once
UMask=0077
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/praya/.local/share/bursawatch-release
ReadWritePaths=/home/praya/.agents/skills
ReadWritePaths=/home/praya/.hermes/bursawatch-control-plane
ReadWritePaths=/home/praya/.hermes/scripts
ReadWritePaths=/home/praya/.logs
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
SystemCallArchitectures=native

# On this host, MemoryDenyWriteExecute implies NoNewPrivileges and prevents
# sudo from acquiring the privilege needed for the narrowly scoped restart.
# Keep both directives unset; the sudoers rule permits only the exact command.
