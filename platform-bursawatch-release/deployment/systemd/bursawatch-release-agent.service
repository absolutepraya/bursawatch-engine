[Unit]
Description=Release eligible Bursawatch main commits
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=praya
Group=praya
EnvironmentFile=/home/praya/.hermes/bursawatch-release-agent.env
Environment=PYTHONPATH=/home/praya/.agents/skills/lib-bursawatch-discord-delivery/bin
ExecStart=/home/praya/.local/lib/bursawatch-release/bursawatch-release-agent.sh --once
UMask=0077
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/praya/.local/share/bursawatch-release
ReadWritePaths=/home/praya/.agents/skills
ReadWritePaths=/home/praya/.hermes/bursawatch-control-plane
ReadWritePaths=/home/praya/.hermes/scripts
ReadWritePaths=/home/praya/.logs
# On this host's systemd 252, the following restrictions implicitly enable
# kernel NoNewPrivs and block sudo's narrow restart rule. Keep them unset; the
# bootstrap removes praya's blanket NOPASSWD rule before starting this service.
