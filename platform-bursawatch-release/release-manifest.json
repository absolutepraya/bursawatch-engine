      "id": "cron-tg-market-news",
      "handler": "runtime",
      "runtime": "bursawatch-tg-market-news",
      "depends_on": ["lib-telegram-resilience", "lib-bursawatch-control", "lib-bursawatch-discord-delivery"],
      "paths": ["cron-tg-market-news/bin/**", "cron-tg-market-news/SKILL.md"],
      "wrappers": [
        {"source": "bursawatch-tg-market-news.sh", "destination": "bursawatch-tg-market-news.sh"},
        {"source": "watchdog-wrapper.sh", "destination": "bursawatch-tg-market-news-watchdog.sh"}
      ],
      "verification": "market-news-no-post"
    },
    {
      "id": "cron-tg-source-ingest-pilot",
      "handler": "runtime",
      "runtime": "bursawatch-tg-source-ingest",
      "depends_on": ["lib-bursawatch-control", "lib-bursawatch-discord-delivery", "lib-bursawatch-pipeline-runtime", "lib-bursawatch-source-ingest-pilot", "lib-bursawatch-source-media", "lib-telegram-resilience", "cron-tg-market-news", "cron-tg-phintraco-swing", "cron-tg-kelas-investasi-gtw"],
      "paths": ["cron-tg-source-ingest/bin/**", "cron-tg-source-ingest/SKILL.md"],
      "wrappers": [{"source": "bursawatch-tg-source-ingest.sh", "destination": "bursawatch-tg-source-ingest.sh"}],
      "verification": "telegram-source-ingest-no-post"
