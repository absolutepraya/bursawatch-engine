      "runtime": "bursawatch-tg-phintraco-swing",
      "depends_on": ["lib-telegram-resilience", "lib-swing-format", "lib-bursawatch-control", "lib-bursawatch-discord-delivery", "lib-bursawatch-source-media", "cron-dc-swing-board"],
