    {
      "id": "lib-bursawatch-source-media",
      "handler": "runtime",
      "runtime": "lib-bursawatch-source-media",
      "paths": ["lib-bursawatch-source-media/bin/**"],
      "verification": "checksum-only"
    },
    {
      "id": "lib-bursawatch-source-media-metadata",
      "handler": "metadata",
      "paths": ["lib-bursawatch-source-media/AGENTS.md", "lib-bursawatch-source-media/README.md", "lib-bursawatch-source-media/tests/**"]
    },
    {
      "id": "lib-bursawatch-discord-delivery",
      "handler": "runtime",
      "runtime": "lib-bursawatch-discord-delivery",
      "paths": ["lib-bursawatch-discord-delivery/bin/**"],
      "verification": "checksum-only"
    },
    {
      "id": "lib-bursawatch-discord-delivery-metadata",
