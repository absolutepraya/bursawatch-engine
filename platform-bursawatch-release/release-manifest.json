{
  "version": 1,
  "units": [
    {
      "id": "repository-metadata",
      "handler": "metadata",
      "paths": [
        ".agents/**",
        ".gitattributes",
        ".github/**",
        ".gitignore",
        ".wt/**",
        "AGENTS.md",
        "DEPLOYMENT.md",
        "README.md",
        "deploy.sh",
        "docs/**",
        "hermes.svg",
        "hermes.webp",
        "pytest.ini",
        "requirements-dev.txt",
        "scripts/**",
        "tests/**",
        "t3.json"
      ]
    },
    {
      "id": "web-applications",
      "handler": "metadata",
      "paths": ["web-config/**", "web-landing/**"]
    },
    {
      "id": "lib-bursawatch-control",
      "handler": "runtime",
      "runtime": "lib-bursawatch-control",
      "paths": ["lib-bursawatch-control/bin/**"],
      "verification": "checksum-only"
    },
    {
      "id": "lib-bursawatch-control-metadata",
      "handler": "metadata",
      "paths": ["lib-bursawatch-control/README.md", "lib-bursawatch-control/tests/**"]
    },
    {
      "id": "lib-bursawatch-pipeline-runtime",
      "handler": "runtime",
      "runtime": "lib-bursawatch-pipeline-runtime",
      "paths": ["lib-bursawatch-pipeline-runtime/bin/**"],
      "verification": "checksum-only"
    },
    {
      "id": "lib-bursawatch-pipeline-runtime-metadata",
      "handler": "metadata",
      "paths": ["lib-bursawatch-pipeline-runtime/README.md", "lib-bursawatch-pipeline-runtime/tests/**"]
    },
    {
      "id": "lib-bursawatch-source-ingest-pilot",
      "handler": "runtime",
      "runtime": "lib-bursawatch-source-ingest-pilot",
      "paths": ["lib-bursawatch-source-ingest/bin/**"],
      "verification": "checksum-only"
    },
    {
      "id": "lib-bursawatch-source-ingest-pilot-metadata",
      "handler": "metadata",
      "paths": ["lib-bursawatch-source-ingest/README.md", "lib-bursawatch-source-ingest/tests/**"]
