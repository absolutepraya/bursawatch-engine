      "wrappers": [
        {"source": "bursawatch-dc-swing-board.sh", "destination": "bursawatch-dc-swing-board.sh"},
        {"source": "bursawatch-dc-swing-board-close.sh", "destination": "bursawatch-dc-swing-board-close.sh"},
