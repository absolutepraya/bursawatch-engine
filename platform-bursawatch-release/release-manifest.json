      "handler": "runtime",
      "runtime": "lib-telegram-resilience",
      "paths": ["lib-telegram-resilience/bin/**"],
      "verification": "checksum-only"
    },
    {
      "id": "lib-telegram-resilience-metadata",
      "handler": "metadata",
      "paths": ["lib-telegram-resilience/README.md", "lib-telegram-resilience/action.yml", "lib-telegram-resilience/tests/**"]
    },
    {
