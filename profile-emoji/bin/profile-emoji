#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "$0")" && pwd)"
env_file="${HOME}/.hermes/.env"

# Read exactly the one credential this helper needs. Do not source the file,
# because the rest of the Hermes environment is not part of this contract.
if [ -r "$env_file" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      DISCORD_BOT_TOKEN=*)
        token_value="${line#DISCORD_BOT_TOKEN=}"
        export DISCORD_BOT_TOKEN="$token_value"
        ;;
    esac
  done < "$env_file"
fi

python_bin="${PROFILE_EMOJI_PYTHON:-/usr/bin/python3}"
exec "$python_bin" "$script_dir/profile_emoji.py" "$@"
