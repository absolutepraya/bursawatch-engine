+// Read-only local resolver for public WhatsApp Channel invite links. This
+// reuses the already-connected bridge socket and never creates another session.
+app.get('/newsletter/metadata/:invite', async (req, res) => {
+  if (!sock || connectionState !== 'connected') {
+    return res.status(503).json({ error: 'Not connected' });
+  }
+
+  const invite = String(req.params.invite || '').trim();
+  if (!/^[A-Za-z0-9_-]{1,128}$/.test(invite)) {
+    return res.status(400).json({ error: 'Invalid newsletter invite' });
+  }
+
+  try {
+    const metadata = await sock.newsletterMetadata('invite', invite);
+    if (!metadata?.id) {
+      return res.status(404).json({ error: 'Newsletter not found' });
+    }
+    return res.json({
+      id: metadata.id,
+      name: metadata.name || '',
+      invite: metadata.invite || invite,
+      subscribers: metadata.subscribers ?? null,
+    });
+  } catch (err) {
+    console.warn('[bridge] newsletter metadata lookup failed:', err?.message || err);
+    return res.status(502).json({ error: 'Newsletter metadata lookup failed' });
+  }
+});
+// Local-only, explicit Channel onboarding. Follow the requested Channel and
+// subscribe the existing socket to live updates. This does not fetch history,
+// enqueue anything, or advance watcher state.
+app.post('/newsletter/follow', async (req, res) => {
+  if (!sock || connectionState !== 'connected') {
+    return res.status(503).json({ error: 'Not connected' });
+  }
+
+  try {
+    const result = await channelSink.followNewsletter({
+      sock,
+      jid: req.body?.jid,
+    });
+    emitDebugEvent({
+      stage: 'newsletter_followed',
+      channelJid: redactWhatsAppId(result.channel_jid),
+      subscribed: result.subscribed,
+      duration: result.duration,
+    });
+    return res.json(result);
+  } catch (err) {
+    if (err?.message === 'Invalid newsletter JID') {
+      return res.status(400).json({ error: err.message });
+    }
+    console.warn('[bridge] newsletter follow failed:', err?.message || err);
+    return res.status(502).json({ error: 'Newsletter follow failed' });
+  }
+});
+// Local-only, bounded, read-only newsletter history lookup. It reuses the
+// existing connected socket and never enqueues or forwards historical posts.
+app.get('/newsletter/messages', async (req, res) => {
+  if (!sock || connectionState !== 'connected') {
+    return res.status(503).json({ error: 'Not connected' });
+  }
+
+  const jid = String(req.query?.jid || '').trim();
+  if (!/^[^@\s]+@newsletter$/.test(jid)) {
+    return res.status(400).json({ error: 'Invalid newsletter JID' });
+  }
+
+  const rawSince = req.query?.since;
+  const rawAfter = req.query?.after;
+  const count = Number(req.query?.count ?? 100);
+  const since = rawSince === undefined ? undefined : Number(rawSince);
+  const after = rawAfter === undefined ? undefined : Number(rawAfter);
+  if (!Number.isInteger(count) || count < 1 || count > 100
+    || (since !== undefined && (!Number.isInteger(since) || since < 0))
+    || (after !== undefined && (!Number.isInteger(after) || after < 0))) {
+    return res.status(400).json({ error: 'Invalid newsletter history bounds' });
+  }
+
+  let timeoutId;
+  try {
+    const result = await Promise.race([
+      sock.newsletterFetchMessages(jid, count, since, after),
+      new Promise((_, reject) => {
+        timeoutId = setTimeout(() => reject(new Error('Newsletter history lookup timed out')), 15000);
+      }),
+    ]);
+    return res.json(result);
+  } catch (err) {
+    console.warn('[bridge] newsletter history lookup failed:', err?.message || err);
+    if (err?.message === 'Newsletter history lookup timed out') {
+      return res.status(504).json({ error: 'Newsletter history lookup timed out' });
+    }
+    return res.status(502).json({ error: 'Newsletter history lookup failed' });
+  } finally {
+    clearTimeout(timeoutId);
+  }
+});
