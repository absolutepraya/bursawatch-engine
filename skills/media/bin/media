#!/usr/bin/env bash
# media - download photos/slides/video from a TikTok/Instagram/Twitter(X) link.
# Routes by host: TikTok -> tikwm.com API (handles photo mode); Instagram/X -> self-hosted cobalt.
# Prints JSON describing what was downloaded.
# Usage: media <url> [--out <dir>]
set -euo pipefail
err(){ echo "media: $*" >&2; exit 1; }

url="${1:-}"; [ -n "$url" ] || err "usage: media <url> [--out <dir>]"; shift
outdir=""
while [ $# -gt 0 ]; do case "$1" in
  --out) outdir="${2:?}"; shift 2;;
  *) err "unknown arg: $1";;
esac; done

host=$(printf '%s' "$url" | sed -E 's#^https?://##; s#/.*##; s#^www\.##' | tr 'A-Z' 'a-z')
case "$host" in
  tiktok.com|vm.tiktok.com|vt.tiktok.com|*.tiktok.com) svc=tiktok;;
  instagram.com|*.instagram.com) svc=instagram;;
  twitter.com|x.com|mobile.twitter.com|*.twitter.com) svc=twitter;;
  *) err "unsupported host '$host' (tiktok / instagram / twitter|x only)";;
esac

outdir="${outdir:-$(mktemp -d /tmp/media-XXXXXX)}"; mkdir -p "$outdir"
caption=""; audio_u=""; type="single"; items=()

if [ "$svc" = tiktok ]; then
  # TikTok via tikwm.com (cobalt's TikTok module is unreliable; tikwm handles photo mode)
  tapi="${TIKWM_API:-https://www.tikwm.com/api/}"
  resp=$(curl -fsS --max-time 60 -H 'User-Agent: Mozilla/5.0' "${tapi}?url=${url}") || err "tikwm request failed"
  [ "$(printf '%s' "$resp" | jq -r '.code // -1')" = "0" ] || err "tikwm error: $(printf '%s' "$resp" | jq -r '.msg // "unknown"')"
  caption=$(printf '%s' "$resp" | jq -r '.data.title // ""')
  mapfile -t items < <(printf '%s' "$resp" | jq -r '.data.images[]? // empty')
  if [ "${#items[@]}" -gt 0 ]; then
    type="carousel"
  else
    v=$(printf '%s' "$resp" | jq -r '.data.play // empty'); [ -n "$v" ] || err "no media in tikwm response"
    items=("$v"); type="single"
  fi
  audio_u=$(printf '%s' "$resp" | jq -r '.data.music // empty')
else
  # Instagram / X via the self-hosted cobalt instance
  capi="${COBALT_API_URL:-}"
  if [ -z "$capi" ] && [ -r "$HOME/.hermes/.env" ]; then
    capi=$(grep -E '^COBALT_API_URL=' "$HOME/.hermes/.env" | head -1 | cut -d= -f2-)
  fi
  capi="${capi:-http://localhost:9009/}"
  resp=$(curl -fsS --max-time 60 -X POST "$capi" -H 'Accept: application/json' -H 'Content-Type: application/json' \
    -d "$(jq -nc --arg u "$url" '{url:$u}')") || err "cobalt request failed"
  status=$(printf '%s' "$resp" | jq -r '.status // "error"')
  [ "$status" = error ] && err "cobalt error: $(printf '%s' "$resp" | jq -r '.error.code // "unknown"')"
  case "$status" in
    picker) mapfile -t items < <(printf '%s' "$resp" | jq -r '.picker[]|select(.type=="photo" or .type=="gif" or .type=="video")|.url'); type="carousel";;
    tunnel|redirect) mapfile -t items < <(printf '%s' "$resp" | jq -r '.url'); type="single";;
    *) err "unexpected cobalt status '$status'";;
  esac
  audio_u=$(printf '%s' "$resp" | jq -r '.audio // empty')
fi
[ "${#items[@]}" -gt 0 ] || err "no media returned for $url"

i=0; files=()
for m in "${items[@]}"; do
  i=$((i+1))
  ext=$(printf '%s' "$m" | sed -E 's/\?.*//; s/.*\.//' | grep -iE '^(jpe?g|png|webp|gif|mp4)$' || true)
  f=$(printf '%s/%02d.%s' "$outdir" "$i" "${ext:-jpg}")
  curl -fsS --max-time 120 -L -o "$f" "$m" || err "download failed: $m"
  files+=("$f")
done
audio_path="null"
if [ -n "$audio_u" ]; then
  ap="$outdir/audio.mp3"; if curl -fsS --max-time 120 -L -o "$ap" "$audio_u"; then audio_path="$ap"; fi
fi

jq -nc --arg src "$url" --arg host "$svc" --arg type "$type" --arg audio "$audio_path" --arg cap "$caption" \
  '{source_url:$src, host:$host, type:$type, caption:$cap, images:$ARGS.positional,
    audio:(if $audio=="null" then null else $audio end), count:($ARGS.positional|length)}' \
  --args "${files[@]}"
